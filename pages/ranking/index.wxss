.honor-card {
  padding-bottom: 20rpx;
}

.honor-grid {
  display: grid;
  gap: 12rpx;
}

.honor-grid.top {
  grid-template-columns: repeat(2, 1fr);
}

.honor-grid.bottom {
  grid-template-columns: repeat(3, 1fr);
  margin-top: 12rpx;
}

.honor-item {
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  text-align: center;
}

.honor-title {
  display: inline-block;
  min-width: 80rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #DCFCE7;
  color: #146C43;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.honor-name {
  margin-top: 6rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
}

.honor-value {
  margin-top: 2rpx;
  color: #16A34A;
  font-size: 22rpx;
}

.tabs {
  display: flex;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6B7280;
}

.tab.active {
  color: #22C55E;
  border-bottom: 4rpx solid #22C55E;
}

.ranking-header, .ranking-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.ranking-header {
  font-weight: 600;
  color: #6B7280;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-item.me {
  background: #DCFCE7;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.rank {
  width: 80rpx;
}

.name {
  flex: 1;
  text-align: center;
}

.points {
  width: 120rpx;
  text-align: right;
  font-weight: 600;
  color: #22C55E;
}
