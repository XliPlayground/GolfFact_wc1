.user-header {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: white;
  padding: 24rpx;
}

.profile-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.avatar-button {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  margin: 2rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  overflow: hidden;
}

.avatar-button::after {
  border: none;
}

.avatar,
.avatar-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.avatar {
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
}

.avatar-img {
  display: block;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  min-height: 52rpx;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 700;
}

.profile-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-phone {
  margin-top: 2rpx;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.profile-hint {
  margin: 2rpx 0 8rpx;
  color: rgba(255,255,255,0.72);
  font-size: 21rpx;
}

.profile-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-level {
  display: inline-block;
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.phone-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.phone-btn {
  display: inline-block;
  margin-top: 0;
  margin-left: 0;
  margin-right: 0;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 999rpx;
  background: rgba(255,255,255,0.16);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.4;
}

.phone-btn::after {
  border: none;
}

.manual-phone-link {
  color: rgba(255,255,255,0.92);
  font-size: 23rpx;
}

.manual-phone-box {
  display: grid;
  grid-template-columns: 1fr 96rpx;
  gap: 12rpx;
  margin-top: 12rpx;
}

.manual-phone-input {
  min-height: 60rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.18);
  color: #FFFFFF;
  font-size: 24rpx;
}

.manual-phone-save {
  min-height: 60rpx;
  line-height: 60rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  color: #146C43;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.hours-card {
  padding: 28rpx 24rpx;
}

.hours-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.hours-label,
.meta-label {
  font-size: 24rpx;
  color: #6B7280;
}

.hours-value {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #22C55E;
  line-height: 1.15;
}

.hours-value text {
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 6rpx;
}

.pending-box {
  min-width: 160rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FEF3C7;
  color: #92400E;
  text-align: center;
  box-sizing: border-box;
}

.pending-value {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.pending-value text {
  margin-left: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.pending-label {
  margin-top: 2rpx;
  font-size: 22rpx;
}

.hours-meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.meta-item {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
}

.meta-value {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.meta-note {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.menu-list {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item .arrow {
  color: #9CA3AF;
}

.menu-item.admin {
  color: #22C55E;
  font-weight: 500;
}
