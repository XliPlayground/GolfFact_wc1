.summary-card {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: white;
  text-align: center;
}

.summary-title {
  font-size: 26rpx;
  opacity: 0.9;
}

.summary-hours {
  font-size: 56rpx;
  font-weight: 700;
  margin: 16rpx 0;
}

.summary-expiry {
  font-size: 24rpx;
  opacity: 0.9;
}

.recharge-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.recharge-item:last-child {
  border-bottom: none;
}

.recharge-hours {
  font-size: 32rpx;
  font-weight: 600;
  color: #22C55E;
}

.recharge-date {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.recharge-expiry {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 8rpx;
}

.recharge-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.recharge-status.valid {
  background: #DCFCE7;
  color: #16A34A;
}

.recharge-status.expired {
  background: #FEE2E2;
  color: #DC2626;
}

.recharge-status.used_up {
  background: #F3F4F6;
  color: #6B7280;
}
