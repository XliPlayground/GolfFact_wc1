<view class="container">
  <!-- 用户信息 -->
  <view class="card user-header">
    <view class="profile-row">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{showAvatarImage}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:if="{{showAvatarInitial}}" class="avatar">{{userInitial}}</view>
      </button>
      <view class="user-info">
        <view class="profile-line">
          <input class="nickname-input" type="nickname" placeholder="填写微信昵称" value="{{nicknameDraft}}" bindinput="onNicknameInput" />
        </view>
        <view class="profile-hint">{{profileHintText}}</view>
        <view class="user-phone">{{userPhoneText}}</view>
        <view class="profile-tags">
          <view class="user-level">{{memberLevelName}}</view>
          <view wx:if="{{showBindPhone}}" class="manual-phone-link" bindtap="showManualPhone">填手机号</view>
        </view>
        <view wx:if="{{showBindPhone}}" class="phone-actions">
          <button class="phone-btn" open-type="getPhoneNumber" bindtap="onBindPhoneTap" bindgetphonenumber="bindPhone">微信授权手机号</button>
        </view>
        <view wx:if="{{showManualPhoneInput}}" class="manual-phone-box">
          <input class="manual-phone-input" type="number" maxlength="11" placeholder="输入手机号" value="{{manualPhone}}" bindinput="onManualPhoneInput" />
          <view class="manual-phone-save" bindtap="saveManualPhone">保存</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 时长卡 -->
  <view class="card hours-card">
    <view class="hours-main">
      <view>
        <view class="hours-label">剩余可约时长</view>
        <view class="hours-value">{{remainingHoursText}}<text>小时</text></view>
      </view>
      <view class="pending-box">
        <view class="pending-value">{{pendingHoursText}}<text>小时</text></view>
        <view class="pending-label">待履约</view>
      </view>
    </view>
    <view class="hours-meta">
      <view class="meta-item">
        <view class="meta-label">最近到期</view>
        <view class="meta-value">{{nearestExpiryLabel}}</view>
        <view class="meta-note">{{expiryStateText}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-label">累计训练</view>
        <view class="meta-value">{{user.totalTrainedHours}}小时</view>
        <view class="meta-note">历史累计</view>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card menu-list">
    <view class="menu-item" bindtap="goTo" data-url="/pages/mine/appointments">
      <text>我的预约</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/mine/recharges">
      <text>充值记录 / 有效期</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/mine/redeem">
      <text>兑换充时卡</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item">
      <text>我的积分</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item">
      <text>爽约记录</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item">
      <text>下场活动报名</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item">
      <text>会员赛报名</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item">
      <text>联系门店</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 管理员入口 -->
  <view class="card menu-list">
    <view class="menu-item admin" bindtap="goToAdmin">
      <text>管理员后台</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
