.booking-page {
  padding-bottom: 24rpx;
}

.date-scroll {
  white-space: nowrap;
}

.date-list {
  display: inline-flex;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 140rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #F3F4F6;
}

.date-item.active {
  background: #22C55E;
  color: white;
}

.date-week {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.date-day {
  font-size: 32rpx;
  font-weight: 600;
}

.bay-list, .type-list, .coach-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.bay-item, .type-item, .coach-item {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.bay-item.active, .type-item.active, .coach-item.active {
  background: #DCFCE7;
  color: #16A34A;
  border: 2rpx solid #22C55E;
}

.slot-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
}

.range-hint {
  color: #374151;
  font-size: 26rpx;
}

.range-selected {
  margin-top: 4rpx;
  color: #16A34A;
  font-size: 24rpx;
  font-weight: 600;
}

.range-reset {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #DCFCE7;
  color: #16A34A;
  font-size: 24rpx;
}

.slot-item {
  min-height: 62rpx;
  padding: 10rpx 4rpx;
  text-align: center;
  background: #F3F4F6;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.slot-item.selected {
  background: #DCFCE7;
  border-color: #22C55E;
}

.slot-item.disabled {
  background: #D1D5DB;
  color: #6B7280;
}

.slot-item.teaching {
  background: #F3F4F6;
}

.slot-time {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.slot-type {
  font-size: 20rpx;
  color: #6B7280;
  margin: 4rpx 0;
}

.slot-price {
  font-size: 22rpx;
  color: #22C55E;
}

.empty-hint {
  width: 100%;
  padding: 24rpx;
  color: #6B7280;
  background: #F9FAFB;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.requirement-scroll {
  white-space: nowrap;
}

.requirement-list {
  display: inline-flex;
  gap: 12rpx;
}

.checkbox-item, .radio-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background: #F9FAFB;
  border-radius: 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.form-item {
  display: flex;
  align-items: center;
}

.form-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #374151;
}

.form-item input {
  flex: 1;
  padding: 12rpx 20rpx;
  background: #F9FAFB;
  border-radius: 8rpx;
}

.visitor-options {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.visitor-option {
  min-height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #F9FAFB;
  border: 2rpx solid transparent;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.visitor-option.active {
  background: #DCFCE7;
  border-color: #22C55E;
  color: #16A34A;
  font-weight: 600;
}

.bottom-bar {
  margin: 24rpx 0 0;
  background: white;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.summary {
  flex: 1;
}

.summary-duration {
  font-size: 32rpx;
  font-weight: 600;
}

.summary-duration.muted {
  color: #6B7280;
  font-size: 28rpx;
  font-weight: 500;
}

.summary-price {
  font-size: 24rpx;
  color: #6B7280;
}

.bottom-bar .btn-primary {
  width: 280rpx;
  margin-left: 24rpx;
}

.bottom-bar .btn-primary.disabled {
  background: #9CA3AF;
}
