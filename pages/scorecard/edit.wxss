.scorecard-page {
  padding-bottom: 40rpx;
}

.course-actions {
  display: grid;
  grid-template-columns: 1fr 112rpx;
  gap: 16rpx;
  align-items: center;
}

.course-picker,
.location-btn {
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  text-align: center;
  font-size: 28rpx;
}

.course-picker {
  padding: 0 20rpx;
  text-align: left;
}

.course-picker.readonly {
  color: #111827;
  font-weight: 700;
}

.location-btn {
  color: #16A34A;
  background: #DCFCE7;
  font-weight: 600;
}

.location-btn.readonly {
  color: #92400E;
  background: #FEF3C7;
}

.autosave {
  margin-top: 14rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}

.score-head,
.hole-item {
  display: grid;
  grid-template-columns: 52rpx 62rpx repeat(3, 76rpx) 1fr;
  gap: 12rpx;
  align-items: center;
}

.score-head {
  padding: 0 0 14rpx;
  color: #6B7280;
  font-size: 22rpx;
  text-align: center;
}

.hole-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hole-item {
  padding: 10rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
}

.hole-number,
.par-value {
  text-align: center;
  color: #374151;
  font-weight: 600;
}

.par-value {
  color: #92400E;
}

.score-picker {
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  color: #16A34A;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.score-readonly {
  min-height: 58rpx;
  line-height: 58rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  color: #111827;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}

.score-readonly.muted {
  color: #6B7280;
  font-weight: 600;
}

.result-tag {
  min-height: 50rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  color: #6B7280;
  background: #F3F4F6;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.result-tag.hole-in-one,
.result-tag.one-chicken {
  color: #92400E;
  background: #FEF3C7;
}

.result-tag.eagle {
  color: #1D4ED8;
  background: #DBEAFE;
}

.result-tag.birdie {
  color: #047857;
  background: #D1FAE5;
}

.result-tag.par {
  color: #146C43;
  background: #DCFCE7;
}

.result-tag.over {
  color: #6B7280;
  background: #F3F4F6;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  text-align: center;
}

.summary-value {
  color: #22C55E;
  font-size: 42rpx;
  font-weight: 700;
}

.summary-label {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 24rpx;
}
