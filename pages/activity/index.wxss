.activity-detail .activity-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.activity-status {
  display: inline-block;
  margin-bottom: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #DCFCE7;
  color: #146C43;
  font-size: 22rpx;
  font-weight: 700;
}

.activity-detail .activity-meta {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.activity-desc {
  font-size: 28rpx;
  line-height: 1.8;
  color: #374151;
}

.activity-subtitle {
  margin-top: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.activity-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  color: #16A34A;
  font-size: 24rpx;
}

.btn-disabled {
  background: #E5E7EB;
  color: #6B7280;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}
