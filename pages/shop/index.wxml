<view class="container">
  <view class="notice">
    <text>本店商品仅做展示，请到店线下支付购买</text>
  </view>
  <view class="category-scroll">
    <view class="category-list">
      <view class="category-item {{selectedCategory === item._id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="_id" bindtap="selectCategory" data-id="{{item._id}}">
        {{item.name}}
      </view>
    </view>
  </view>
  <view class="product-list">
    <view class="product-item" wx:for="{{products}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
      <view class="product-placeholder">🛍️</view>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="product-price">¥{{item.price}}</view>
      </view>
    </view>
  </view>
</view>