.notice {
  background: #FEF3C7;
  color: #92400E;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.category-scroll {
  margin-bottom: 24rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  background: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.category-item.active {
  background: #22C55E;
  color: white;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-item {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-placeholder {
  height: 200rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 32rpx;
  color: #22C55E;
  font-weight: 600;
}