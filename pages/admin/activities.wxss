.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-head .section-title {
  margin-bottom: 2rpx;
}

.head-subtitle {
  color: #6B7280;
  font-size: 23rpx;
}

.head-action {
  min-width: 108rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #22C55E;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.form-card {
  padding-bottom: 28rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.field-block {
  margin-bottom: 14rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #374151;
  font-size: 23rpx;
  font-weight: 700;
}

.field-input,
.field-picker,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  font-size: 26rpx;
}

.field-picker {
  line-height: 44rpx;
  margin-bottom: 12rpx;
  color: #146C43;
  font-weight: 700;
}

.time-pair {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 10rpx;
}

.field-picker.compact {
  margin-bottom: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
  color: #374151;
  font-size: 23rpx;
  text-align: center;
}

.field-textarea {
  min-height: 120rpx;
}

.field-textarea.compact {
  min-height: 96rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.list-head .section-title {
  margin-bottom: 0;
}

.tabs {
  display: flex;
  width: 260rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.tab {
  flex: 1;
  padding: 12rpx 0;
  color: #6B7280;
  font-size: 23rpx;
  text-align: center;
}

.tab.active {
  background: #DCFCE7;
  color: #146C43;
  font-weight: 700;
}

.activity-card {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.activity-card:last-child {
  border-bottom: none;
}

.activity-main,
.status-row,
.action-row,
.registration-row,
.registration-actions {
  display: flex;
  align-items: center;
}

.activity-main {
  justify-content: space-between;
}

.activity-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.activity-meta {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 23rpx;
}

.activity-count {
  color: #16A34A;
  font-size: 32rpx;
  font-weight: 800;
}

.status-row {
  justify-content: space-between;
  margin-top: 14rpx;
  color: #92400E;
  font-size: 23rpx;
}

.action-row {
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.small-btn,
.mini-btn {
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  background: #F3F4F6;
  color: #374151;
  font-size: 23rpx;
}

.small-btn.primary,
.mini-btn.primary {
  background: #DCFCE7;
  color: #146C43;
}

.small-btn.danger,
.mini-btn.danger {
  background: #FEE2E2;
  color: #B91C1C;
}

.registration-list {
  margin-top: 14rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  overflow: hidden;
}

.registration-empty {
  padding: 18rpx;
  color: #9CA3AF;
  font-size: 23rpx;
  text-align: center;
}

.registration-row {
  justify-content: space-between;
  padding: 14rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.registration-row:last-child {
  border-bottom: none;
}

.registration-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}

.registration-status {
  color: #6B7280;
  font-size: 22rpx;
}

.registration-actions {
  gap: 10rpx;
}

.empty-state.compact {
  padding: 40rpx 20rpx;
}
