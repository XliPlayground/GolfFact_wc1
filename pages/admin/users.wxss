.profile-form {
  display: grid;
  gap: 14rpx;
}

.workbench {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
  align-items: start;
}

.list-card {
  position: static;
}

.detail-column {
  min-width: 0;
}

.search-row {
  display: grid;
  grid-template-columns: 1fr 96rpx;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.clear-btn {
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 24rpx;
  text-align: center;
}

.user-scroll {
  max-height: 520rpx;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.user-row.active {
  color: var(--primary-dark);
  background: #F0FDF4;
  margin: 0 -12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 10rpx;
}

.user-row:last-child {
  border-bottom: none;
}

.user-name,
.coach-name {
  font-size: 30rpx;
  font-weight: 600;
}

.user-main {
  min-width: 0;
}

.user-meta,
.coach-tags {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.coach-count {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: var(--secondary);
  color: var(--primary-dark);
  font-size: 22rpx;
}

.coach-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.coach-row:last-child {
  border-bottom: none;
}

.field-picker {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  box-sizing: border-box;
}

.form-actions {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.form-btn {
  min-height: 76rpx;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.user-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.mini-btn,
.warn-mini-btn,
.danger-mini-btn {
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.mini-btn {
  background: #F3F4F6;
  color: #374151;
}

.warn-mini-btn {
  background: #FEF3C7;
  color: #B45309;
}

.danger-mini-btn {
  background: #FEE2E2;
  color: #DC2626;
}

.member-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.member-summary > view {
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  text-align: center;
}

.summary-label {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.summary-value {
  margin-top: 4rpx;
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
}

.adjust-box {
  display: grid;
  gap: 14rpx;
}

.field-input {
  width: 100%;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  box-sizing: border-box;
}

.adjust-btn {
  padding: 18rpx 0;
  font-size: 28rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.record-row:last-child {
  border-bottom: none;
}

.record-title {
  font-size: 28rpx;
  font-weight: 600;
}

.record-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.record-status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 22rpx;
}

.status-booked {
  background: #DCFCE7;
  color: #16A34A;
}

.status-cancelled,
.status-no_show {
  background: #FEE2E2;
  color: #DC2626;
}

.compact {
  padding: 28rpx 16rpx;
}

@media (max-width: 700px) {
  .user-scroll {
    max-height: 520rpx;
  }
}
