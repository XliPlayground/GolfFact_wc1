.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-subtitle {
  color: #6B7280;
  font-size: 23rpx;
}

.head-action,
.small-btn.primary {
  background: #22C55E;
  color: #FFFFFF;
}

.head-action {
  min-width: 130rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  text-align: center;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.field-block {
  margin-bottom: 14rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: #374151;
  font-size: 23rpx;
  font-weight: 700;
}

.field-input,
.field-picker {
  width: 100%;
  box-sizing: border-box;
  min-height: 76rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #F9FAFB;
  font-size: 26rpx;
}

.list-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.row-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 700;
}

.row-meta {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 23rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.action-row.inline {
  flex-shrink: 0;
  align-items: center;
  margin-top: 0;
}

.small-btn,
.mini-btn {
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #F3F4F6;
  color: #374151;
  font-size: 23rpx;
}

.generate-btn {
  margin-bottom: 16rpx;
  text-align: center;
}

.small-btn.danger {
  background: #FEE2E2;
  color: #B91C1C;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.slot-card {
  min-height: 136rpx;
  padding: 12rpx;
  border-radius: 10rpx;
  background: #F3F4F6;
  border: 2rpx solid #E5E7EB;
}

.slot-card.open {
  background: #ECFDF5;
  border-color: #86EFAC;
}

.slot-card.closed {
  background: #F9FAFB;
  color: #9CA3AF;
}

.slot-card.booked {
  background: #EFF6FF;
  border-color: #93C5FD;
}

.slot-time {
  font-size: 22rpx;
  font-weight: 700;
}

.slot-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
}

.slot-actions {
  display: flex;
  gap: 6rpx;
  margin-top: 8rpx;
}

.mini-btn {
  flex: 1;
  padding: 6rpx 4rpx;
  text-align: center;
  font-size: 19rpx;
}

.empty-state.compact {
  padding: 36rpx 20rpx;
}
