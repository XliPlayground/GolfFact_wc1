.field-input,
.field-picker {
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.user-row,
.recharge-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-row:last-child,
.recharge-row:last-child {
  border-bottom: none;
}

.user-name,
.recharge-title {
  font-size: 30rpx;
  font-weight: 600;
}

.user-meta,
.recharge-meta {
  margin-top: 4rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.hours-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-dark);
}

.status-pill {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: var(--secondary);
  color: var(--primary-dark);
  font-size: 22rpx;
}
