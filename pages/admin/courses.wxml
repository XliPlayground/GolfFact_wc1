<view class="container">
  <view class="card page-head">
    <view>
      <view class="section-title">球场管理</view>
      <view class="head-subtitle">维护球场、18洞标准杆和场地特点</view>
    </view>
    <view class="head-actions">
      <view class="head-action secondary" bindtap="importRegionalCourses">导入京津冀</view>
      <view class="head-action" bindtap="resetForm">新建</view>
    </view>
  </view>

  <view wx:if="{{isEditing}}" class="card form-card">
    <view class="section-title">球场信息</view>
    <view class="field-block">
      <view class="field-label">球场名称</view>
      <input class="field-input" placeholder="例如 上海旭宝高尔夫俱乐部" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-grid">
      <view class="field-block">
        <view class="field-label">省份</view>
        <input class="field-input" placeholder="上海" value="{{form.province}}" data-field="province" bindinput="onInput" />
      </view>
      <view class="field-block">
        <view class="field-label">城市</view>
        <input class="field-input" placeholder="上海" value="{{form.city}}" data-field="city" bindinput="onInput" />
      </view>
    </view>
    <view class="field-block">
      <view class="field-label">地址</view>
      <input class="field-input" placeholder="详细地址" value="{{form.address}}" data-field="address" bindinput="onInput" />
    </view>
    <view class="form-grid">
      <view class="field-block">
        <view class="field-label">纬度</view>
        <input class="field-input" placeholder="可空" value="{{form.latitude}}" data-field="latitude" bindinput="onInput" />
      </view>
      <view class="field-block">
        <view class="field-label">经度</view>
        <input class="field-input" placeholder="可空" value="{{form.longitude}}" data-field="longitude" bindinput="onInput" />
      </view>
      <view class="field-block">
        <view class="field-label">洞数</view>
        <input class="field-input" type="number" value="{{form.holeCount}}" data-field="holeCount" bindinput="onInput" />
      </view>
      <view class="field-block">
        <view class="field-label">来源</view>
        <input class="field-input" value="{{form.dataSource}}" data-field="dataSource" bindinput="onInput" />
      </view>
    </view>
    <view class="field-block">
      <view class="field-label">每洞标准杆</view>
      <view class="par-grid">
        <picker wx:for="{{parsGrid}}" wx:key="holeNumber" mode="selector" range="{{parOptions}}" value="{{item.parPickerIndex}}" data-index="{{index}}" bindchange="onParPickerChange">
          <view class="{{item.className}}">
            <view class="par-hole">{{item.holeNumber}}</view>
            <view class="par-number">{{item.parText}}</view>
          </view>
        </picker>
      </view>
      <view class="par-actions">
        <view class="small-btn" bindtap="buildNineHoleUnits">生成前9/后9</view>
        <view class="small-btn danger" bindtap="clearPars">清空标准杆</view>
      </view>
      <textarea class="field-textarea compact" placeholder="也可粘贴18个数字，例如 4,5,4,3..." value="{{form.parsText}}" data-field="parsText" bindinput="onInput"></textarea>
    </view>
    <view class="field-block">
      <view class="field-label">9洞单元</view>
      <textarea class="field-textarea" placeholder="一行一个：前9:4,5,4,3,4,4,5,3,4；后9:4,4,3,5,4,4,5,3,4" value="{{form.nineHoleText}}" data-field="nineHoleText" bindinput="onInput"></textarea>
    </view>
    <view class="field-block">
      <view class="field-label">18洞组合</view>
      <textarea class="field-textarea compact" placeholder="一行一个：前9+后9；A+B；B+C" value="{{form.comboText}}" data-field="comboText" bindinput="onInput"></textarea>
    </view>
    <view class="field-block">
      <view class="field-label">标准杆来源</view>
      <input class="field-input" placeholder="例如 老板记分卡照片、球场官网、Garmin导入" value="{{form.parSource}}" data-field="parSource" bindinput="onInput" />
    </view>
    <view class="field-block">
      <view class="field-label">场地特点</view>
      <textarea class="field-textarea compact" placeholder="球道、水障碍、果岭、适合活动等备注" value="{{form.features}}" data-field="features" bindinput="onInput"></textarea>
    </view>
    <view class="btn-primary mt-24" bindtap="saveCourse">保存球场</view>
  </view>

  <view class="card">
    <view class="section-title">基础库</view>
    <view wx:if="{{showEmpty}}" class="empty-state compact">暂无球场</view>
    <view wx:for="{{courses}}" wx:key="_id" class="course-card">
      <view class="course-main" bindtap="selectCourse" data-id="{{item._id}}">
        <view>
          <view class="course-title">{{item.name}}</view>
          <view class="course-meta">{{item.regionText}} · {{item.holeCountText}}洞 · {{item.parStatusText}} · Par {{item.totalParText}}</view>
          <view class="course-feature">{{item.features}}</view>
          <view wx:if="{{item.parSource}}" class="course-feature">来源：{{item.parSource}}</view>
          <view wx:if="{{item.comboSummary}}" class="course-feature">组合：{{item.comboSummary}}</view>
        </view>
      </view>
      <view class="pars-line">{{item.parsText}}</view>
      <view class="action-row">
        <view class="small-btn" bindtap="selectCourse" data-id="{{item._id}}">编辑</view>
        <view class="small-btn danger" bindtap="deleteCourse" data-id="{{item._id}}">删除</view>
      </view>
    </view>
  </view>
</view>
