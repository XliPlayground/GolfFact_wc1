.coach-avatar {
  width: 200rpx;
  height: 200rpx;
  background: #DCFCE7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin: 0 auto 32rpx;
}

.coach-name {
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.coach-tags {
  text-align: center;
  margin-bottom: 24rpx;
}

.coach-intro {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.coach-rate {
  text-align: center;
  font-size: 36rpx;
  color: #22C55E;
  font-weight: 700;
  margin-bottom: 32rpx;
}